    {
      "name": "CP-INT-009 | POST /api/checkout/comprar exitoso (DISPONIBLE -> VENDIDA)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_comprador}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{api_url}}/api/checkout/comprar",
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"id_prenda\": 0, \"precio\": 65000}], \"envio\": {\"nombre\": \"Andres Comprador\", \"telefono\": \"3009990002\", \"email\": \"qa.comprador@vint-qa.test\", \"direccion\": \"Cra 15 # 80-20\", \"ciudad\": \"Bogotá D.C.\"}, \"costo_envio\": 15000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const raw = JSON.parse(pm.request.body.raw);",
              "raw.items[0].id_prenda = parseInt(pm.environment.get('qa_prenda_id'), 10);",
              "pm.request.body.raw = JSON.stringify(raw);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 pedido creado y prenda marcada VENDIDA', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "  const d = pm.response.json();",
              "  pm.expect(d.success).to.eql(true);",
              "  const pedidos = d.pedidos || d.data || [];",
              "  if (Array.isArray(pedidos) && pedidos.length > 0 && pedidos[0].id) {",
              "    pm.environment.set('qa_pedido_id', String(pedidos[0].id));",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
