          "mode": "raw",
          "raw": "{\"name\": \"Chaqueta Denim QA Sintetica\", \"description\": \"Prenda sintetica creada por suite Newman PR-05\", \"price\": 65000, \"category_id\": 9, \"brand_id\": 2, \"size\": \"M\", \"color\": \"Azul\", \"gender\": \"Unisex\", \"id_estado_prenda\": 5, \"status\": \"DISPONIBLE\"}",
