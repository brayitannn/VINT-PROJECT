  "item": [
    {
      "name": "CP-INT-001a | Supabase Auth Login Vendedor (válido)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_anon_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{vendedor_email}}\", \"password\": \"{{qa_password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y access_token JWT emitido', function () {",
              "  pm.response.to.have.status(200);",
              "  const d = pm.response.json();",
              "  pm.expect(d.access_token).to.be.a('string').and.not.empty;",
              "  pm.environment.set('jwt_vendedor', d.access_token);",
              "});"
            ]
          }
        }
      ]
    },
