          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 y prenda creada en BD', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "  const d = pm.response.json();",
              "  const pid = d.id || (d.data && (d.data.id || d.data.id_prenda)) || d.id_prenda;",
